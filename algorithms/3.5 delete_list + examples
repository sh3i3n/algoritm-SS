#include<iostream>
#include<cstdio>
using namespace std;
template<typename T> struct list /*написал темплейт, чтобы в качестве данных структуры
мы могли использовать, что угодно*/
{
	T item; //данные
	list* next; //указатель на следующий элемент
	list()
	{
		item = 0;
		next = nullptr;
	}
	list(double n) //конструктор для связанного списка типа double
	{
		item = n;
		next = nullptr;
	}
	~list()
	{
		cout << "удалён элемент - " << item << endl;
	}
};
template<typename T> list<T>* search_list(list<T>* l, T x) //стоит тут вообще чтото объяснять?
/*функция для рекурсивного поиска элемента в связном списке,
если проще, то функция, которая ищет элемент в списке, за счёт вызовов самой себя,
но от следующих элементов, то есть мы идём сверху вниз по списку и сравниваем элменты
с нужным нам
*/
{
	if (l == nullptr) //если мы дошли до конца списка
	{
		return(nullptr); //возвращаем нулевой указатель, элемент не найден
	}
	if (l->item == x)
	{
		return l;
	}
	else
	{
		return search_list(l->next, x); //рекурентный вызов
	}
}
template<typename T> list<T>* item_ahead(list<T>* lst, list<T>* del_el)
/*функция ищет элемент перед удаляющимся, за счёт рекурсии
 первый аргумент - начало нашего списка,
 в качестве удаляемого элемента выступает второй аргумет*/
{	if ((lst == nullptr) || (lst->next == nullptr)) /*если указатель на наш список
	равен нулевому, то это конец*/
	{
		return nullptr;
	}
	if ((lst->next) == del_el) /*если следующий элемент нашего листа - искомый, возвращаем
	предшествующий ему*/ {
		return lst;
	}
	else
	{
		return item_ahead(lst->next, del_el); /*вызываем эту же функцию, но от следующего
	элемента, таким образом мы идём по нашего списку сверху вниз, ища нужный указатель*/
	}
}
template<typename T> void delete_list(list<T>* lst, list<T>* del_el) //функция, удаляющая один элемент связанного списка
//чтобы удалить элемент, который находиться не в конце списка нам нужно сшить предыдущий элемент и следующий
//в качестве аргументов функция принимает указатель на начало списка и указатель на удаляемый элемент
{
	list<T>* p; //указатель на начало списка
	list<T> *pred;//указатель на предыдущий элемент
	p = lst;
	pred = item_ahead(lst, del_el); //ищем предыдущий элемент 
	if (pred == nullptr) //если предыдущего элемента нет, то оставляем всё как есть
	{
		lst = p->next;
	}
	else //если нашли, то приравниваем следующий за удаляемым элемент в указатель на следующий элемент у найденного
	{
		pred->next = del_el->next;
	}
	delete del_el;
}
int main()
{
	system("chcp 1251>nul");
	list<double>* obj = new list<double>, *tObj, *del_el;
	tObj = obj;
	for (int i = 1; i < 5; i++)//задание связанного списка
	{
		tObj->next = new list<double>(i);
		tObj = tObj->next;
	}
	del_el = search_list(obj, double(2));
	delete_list(obj, del_el);
	while (obj->next != nullptr)
	{
		delete_list(obj, obj->next);
	}
	delete obj;
	return 0;
}
